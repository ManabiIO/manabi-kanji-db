{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ManabiIO/manabi-kanji-db/blob/main/schemas/claim.schema.json",
  "title": "Manabi Kanji DB claim",
  "allOf": [
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "approved"}}},
      "then": {"properties": {"review": {"properties": {"state": {"const": "approved"}}, "required": ["reviewer", "reviewedAt", "claimRevision", "sourceRevision", "rationale"]}}}
    },
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "mnemonic"}}},
      "then": {"required": ["story"]}
    }
  ],
  "type": "object", "additionalProperties": false,
  "required": ["id", "kind", "subject", "revision", "localizedRevision", "status", "claimText", "targetLanguage", "locale", "author", "license", "evidence", "review"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"},
    "kind": {"enum": ["visual-name", "semantic-function", "historical-phonetic", "modern-japanese-sound", "historical-origin", "reading-example", "mnemonic"]},
    "subject": {"oneOf": [
      {"type":"object","additionalProperties":false,"required":["type","literal","codepoint"],"properties":{"type":{"const":"character"},"literal":{"type":"string","minLength":1,"maxLength":1},"codepoint":{"type":"string","pattern":"^U\\+[0-9A-F]{4,6}$"}}},
      {"type":"object","additionalProperties":false,"required":["type","id"],"properties":{"type":{"const":"component"},"id":{"type":"string","pattern":"^[a-z0-9]+(?:[-.][a-z0-9]+)*$"}}},
      {"type":"object","additionalProperties":false,"required":["type","structure","occurrence"],"properties":{"type":{"const":"occurrence"},"structure":{"type":"string","minLength":1},"occurrence":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["type","id"],"properties":{"type":{"enum":["asset","reading","sense"]},"id":{"type":"string","minLength":1}}}
    ]},
    "revision": {"type":"string","minLength":1}, "localizedRevision":{"type":"string","minLength":1}, "status": {"enum":["candidate","approved","rejected","stale","withheld"]},
    "claimText": {"type":"string","minLength":1}, "targetLanguage":{"type":"string","minLength":2},
    "locale":{"type":"string","pattern":"^[a-z]{2,3}(?:-[A-Za-z0-9-]+)?$"},
    "author":{"type":"object","additionalProperties":false,"required":["name","type","recordedAt"],"properties":{"name":{"type":"string","minLength":1},"type":{"enum":["human","agent","community"]},"recordedAt":{"type":"string","format":"date"}}},
    "license":{"const":"CC-BY-SA-4.0"},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["reference","claimField","supportType","selector"],"properties":{"reference":{"type":"string","pattern":"^[a-z0-9]+(?:[-.][a-z0-9]+)*$"},"claimField":{"type":"string","minLength":1},"supportType":{"type":"string","minLength":1},"selector":{"type":"string","minLength":1}}}},
    "review":{"type":"object","additionalProperties":false,"required":["state"],"properties":{"state":{"enum":["pending","approved","rejected","stale"]},"reviewer":{"type":["string","null"]},"reviewedAt":{"type":["string","null"],"format":"date"},"claimRevision":{"type":["string","null"]},"sourceRevision":{"type":["string","null"]},"rationale":{"type":["string","null"]}}},
    "translationOf":{"type":["object","null"],"additionalProperties":false,"required":["claim","locale","textRevision"],"properties":{"claim":{"type":"string"},"locale":{"type":"string"},"textRevision":{"type":"string"}}},
    "story":{"type":"object","additionalProperties":false,"required":["locale","originality","targetReference","targetSelector","occurrences","fiction","textRevision"],"properties":{"locale":{"type":"string"},"originality":{"enum":["original","adapted"]},"targetReference":{"type":"string"},"targetSelector":{"type":"string"},"occurrences":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["structure","occurrence","labelClaim","authoredForm","crosswalk"],"properties":{"structure":{"type":"string"},"occurrence":{"type":"string"},"labelClaim":{"type":"string"},"authoredForm":{"type":"string","minLength":1,"maxLength":1},"crosswalk":{"type":["object","null"],"additionalProperties":false,"required":["fromCodepoint","toCodepoint","sourceAttribute","reference"],"properties":{"fromCodepoint":{"type":"string"},"toCodepoint":{"type":"string"},"sourceAttribute":{"type":"string"},"reference":{"type":"string"}}}}}},"fiction":{"const":true},"textRevision":{"type":"string"}}}
  }
}
