{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manabi.io/schemas/joyo-appendix.schema.json",
  "title": "2010 Jōyō Kanji appendix whole word readings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": {"const": 1},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "spelling", "reading", "sourceRow", "role", "entryIDs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "spelling": {"type": "string", "minLength": 1},
        "reading": {"type": "string", "minLength": 1},
        "sourceRow": {"type": "integer", "minimum": 1, "maximum": 116},
        "role": {"enum": ["primary", "alternate", "example"]},
        "entryIDs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
